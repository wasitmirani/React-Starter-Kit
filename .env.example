# Core API (backend-nestjs). Every module calls `${VITE_API_BASE_URL}/...`.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Modules served by the in-browser demo API instead of the backend.
# `true` = all, `false` = none, or a list of the modules still mocked:
# commerce,inventory,warehouse,procurement,shipping,threepl,integrations,platform
# Auth, workspaces, team, roles, API keys and audit always call the backend
# (or the offline demo session when the backend is unreachable).
VITE_USE_MOCKS=true

VITE_APP_NAME=LinqWorks
VITE_APP_TITLE=LinqWorks · Order & Warehouse Operations
VITE_APP_DESCRIPTION=Unified OMS and WMS for merchants and 3PLs in Pakistan and the UAE
VITE_APP_KEYWORDS=oms, wms, inventory, warehouse, 3pl, shipping, pakistan, uae
VITE_APP_AUTHOR=LinqWorks
VITE_APP_URL=http://localhost:5173/
VITE_APP_OG_IMAGE=/assets/images/og-image.png

# Demo account: "Try the demo account" on the login page. Always on in development;
# in a production build only when VITE_DEMO_MODE=true. Works offline (local session).
# Match SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD in backend-nestjs/.env once it seeds users.
VITE_DEMO_EMAIL=demo@linqworks.app
VITE_DEMO_PASSWORD=Demo@12345
VITE_DEMO_MODE=false
