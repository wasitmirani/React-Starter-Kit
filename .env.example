# Core API (backend-nestjs)
VITE_API_BASE_URL=http://localhost:8888/api/v1

# true: product modules (CRM, campaigns, inbox, channels…) use the in-browser demo API
# until their backend endpoints exist. Auth and workspace settings always use the API.
VITE_USE_MOCKS=true

VITE_APP_NAME=BirdCRM
VITE_APP_TITLE=BirdCRM
VITE_APP_DESCRIPTION=Omnichannel customer engagement platform
VITE_APP_KEYWORDS=email, sms, whatsapp, crm, campaigns
VITE_APP_AUTHOR=BirdCRM
VITE_APP_URL=http://localhost:5173/
VITE_APP_OG_IMAGE=/assets/images/og-image.png

# Demo account: a "Sign in as demo" button on the login page. Always on in development;
# in a production build only if VITE_DEMO_MODE=true. It works even when the backend or
# database is down (local offline demo session).
# Must match SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD in backend-nestjs/.env (created by `npm run seed`).
VITE_DEMO_EMAIL=admin@example.com
VITE_DEMO_PASSWORD=Password123!
VITE_DEMO_MODE=false
